<div class="container">
  <div class="flex gap-4 mt-6">
    <div class="w-full md:w-1/2 bg-gray-100 p-6">
      {% if product.featured_image %}
        <a href="{{ product.url }}">
          <img
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="{{ product.title }}"
            width="600"
            height="600"
          >
        </a>
      {% endif %}
    </div>
    <div class="w-full md:w-1/2 bg-gray-100 p-6">
      <h1 class="text-3xl py-2">{{ product.title }}</h1>
      <h3 class="text-base py-2">{{ product.price | money }}</h3>
      {{ product.description }}
       <form method="post" action="{{ routes.cart_add_url }}">
        {% form 'product', product %}
      <input
        type="hidden"
        name="id"
        value="{{ product.selected_or_first_available_variant.id }}"
      >

      <button
        type="submit"
        class="bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700 mt-4"
      >
        Add to Cart
      </button>
      {% endform %}
    </form>
    </div>
  </div>
  <div class="w-full p-2 border-b border-gray border-black/20">
   
  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
