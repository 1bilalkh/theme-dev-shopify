<h1>{{ collection.title }}</h1>

<div class="flex-container">
 
  {% for product in collection.products %}
    <div class="product-card">
      <a href="{{ product.url }}">
        {{ product.featured_image | image_url: width: 400 | image_tag }}
        <h3>{{ product.title }}</h3>
        <p>{{ product.price | money }}</p>
      </a>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Main Collection"
}
{% endschema %}