<section class="container">
  
<h1 class="text-3xl pb-6 pt-6">{{ collection.title }}</h1>

<div class="flex flex-col lg:flex-row gap-6">
  <aside class="w-full lg:w-1/4 bg-gray-100 p-5 rounded-lg">
    {% render 'collection-filters' %}
  </aside>
  <div class="w-full lg:w-3/4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  {% for product in collection.products %}
    <div class="border border-black/20 p-3 rounded-lg">
      <a href="{{ product.url }}">
        {{ product.featured_image | image_url: width: 400 | image_tag }}
        <h3 class="text-xl-2 font-normal pt-4">{{ product.title | truncatewords: 6  }}</h3>
        <p class="text-lg font-medium">{{ product.price | money }}</p>
      </a>
      </div>
       {% endfor %}
    
 
  </div>
</div>
</div>
</section>
{% schema %}
{
  "name": "Main Collection"
}
{% endschema %}