<div class="container">
  <h1 class="text-2xl md:text-2xl font-bold text-gray-900 py-8">Your Shopping Cart</h1>

  {% if cart.item_count > 0 %}
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="w-full lg:w-2/3">
        <div class="space-y-3">
          {% for item in cart.items %}
            <div class="flex items-center justify-between border border-gray-200 rounded-lg p-6 shadow-sm">
              <div class="flex gap-3 align-center">
                <a
                  href="{{ item.url_to_remove }}"
                  class="mr-1 text-red-600 hover:text-red-700"
                  aria-label="Remove {{ item.product.title }} from cart"
                >
                   <button class="close" aria-label="Close menu">
      <svg class="icon icon-close" viewBox="0 0 20 20" fill="currentColor" width="24" height="24">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
      </svg>
    </button>
                </a>

                <div class="cartimg_aftershop">
                  {{
                    item.image
                    | image_url: width: '100%'
                    | image_tag: alt: item.product.title, class: 'object-cover rounded border'
                  }}
                </div>
                <div>
                  <h3 class="text-xl-3 font-normal text-gray-800">
                    {{ item.product.title | truncatewords: 8 }}
                  </h3>

                  <form action="{{ routes.cart_url }}" method="post">
                   
                      <input
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        class="border rounded-lg border-gray-300 ps-3 w-25 py-2 my-2"
                      >
                   

                    <button type="submit" name="update" class="border-b ms-4">Update Cart</button>
                  </form>
                  <p class="text-xl font-bold text-purple-600 pt-2">
                    {{ item.final_line_price | money }}
                  </p>
                </div>
              </div>

              <div></div>

              <div></div>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="w-full lg:w-1/3">
        <div class="border border-gray-200 rounded-lg p-6 shadow-sm sticky top-6">
          <h2 class="text-2xl font-semibold mb-6">Order Summary</h2>

          <div class="flex justify-between mb-3">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <div class="flex justify-between mb-3">
            <span>Shipping</span>
            <span>Calculated at checkout</span>
          </div>

          <div class="flex justify-between mb-6">
            <span>Taxes</span>
            <span>Calculated at checkout</span>
          </div>

          <hr>

          <div class="flex justify-between text-xl font-bold my-6">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <div class="mt-10 flex justify-end">
            <a
              href="/checkout"
              class="btn-gradient w-100"
            >
              Proceed to Checkout
            </a>
          </div>
        </div>
      </div>
    </div>

  {% else %}
    <div class="text-center py-20">
      <h2 class="text-2xl font-semibold text-gray-700 mb-3">Your cart is empty</h2>

      <p class="text-gray-500 mb-8">Looks like you haven't added any products yet.</p>

      <a
        href="{{ routes.collections_url }}/all"
        class="btn-gradient w-75 mx-auto"
      >
        Continue Shopping
      </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
