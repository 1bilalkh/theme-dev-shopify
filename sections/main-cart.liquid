<h1>Cart</h1>

{% if cart.item_count > 0 %}
  {% for item in cart.items %}
    <div>
      <h3>{{ item.product.title }}</h3>
      <p>Quantity: {{ item.quantity }}</p>
      <p>{{ item.final_line_price | money }}</p>
    </div>
  {% endfor %}
{% else %}
  <p>Your cart is empty.</p>
{% endif %}

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}