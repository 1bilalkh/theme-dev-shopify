<div class="max-w-5xl mx-auto px-4 py-10">

  <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
    Your Shopping Cart
  </h1>

  {% if cart.item_count > 0 %}

    <div class="space-y-6">

      {% for item in cart.items %}

        <div class="flex items-center justify-between border border-gray-200 rounded-lg p-6 shadow-sm">

          <div>
            <h3 class="text-xl font-semibold text-gray-800">
              {{ item.product.title }}
            </h3>

            <p class="text-gray-600 mt-2">
              Quantity:
              <span class="font-medium text-gray-900">
                {{ item.quantity }}
              </span>
            </p>
          </div>

          <div>
            <p class="text-xl font-bold text-indigo-600">
              {{ item.final_line_price | money }}
            </p>
          </div>

        </div>

      {% endfor %}

    </div>

    <div class="mt-10 flex justify-end">
      <a href="/checkout"
         class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-lg transition duration-300">
        Proceed to Checkout
      </a>
    </div>

  {% else %}

    <div class="text-center py-20">

      <h2 class="text-2xl font-semibold text-gray-700 mb-3">
        Your cart is empty
      </h2>

      <p class="text-gray-500 mb-8">
        Looks like you haven't added any products yet.
      </p>

      <a href="{{routes.collections_url}}"
         class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-lg font-medium transition duration-300">
        Continue Shopping
      </a>


    </div>

  {% endif %}

</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}