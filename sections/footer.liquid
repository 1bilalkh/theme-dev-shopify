<div class="flex flex-wrap gap-2">
  <!-- Company -->
  <div class="basis-full md:basis-[35%] md:pr-4">
    <h2 class="text-2xl font-bold text-white mb-4">
      {{ shop.name }}
    </h2>
    <p class="text-white text-base">
      We offer a wide selection of high-quality products at competitive prices. Our mission is to provide a secure,
      convenient, and enjoyable shopping experience with fast shipping, reliable customer support, and easy returns.
    </p>
  </div>

  <!-- Quick Links -->
  <div class="basis-full md:basis-1/5 md:ps-4">
    <h3 class="text-white text-lg font-semibold mb-4">Quick Links</h3>

    <ul class="space-y-3">
      {% for link in linklists[section.settings.footer_menu].links %}
        <li>
          <a
            href="{{ link.url }}"
            class="text-gray-300 hover:text-white transition"
          >
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>

  <!-- Services -->
  

  <!-- Contact -->
  <div class="basis-full md:basis-1/5">
    <h3 class="text-white text-lg font-semibold mb-4">Contact</h3>

    <ul class="space-y-3">
      <li class="text-white text-base">Email: info@example.com</li>
      <li class="text-white text-base">Phone: +92 300 1234567</li>
      <li class="text-white text-base">Karachi, Pakistan</li>
    </ul>

    <!-- Social Icons -->
    <div class="flex gap-4 mt-6">
      <a
        href="#"
        class="text-white w-10 h-10 rounded-full bg-gray-800 hover:bg-indigo-600 flex items-center justify-center transition"
      >
        FB
      </a>

      <a
        href="#"
        class="text-white w-10 h-10 rounded-full bg-gray-800 hover:bg-indigo-600 flex items-center justify-center transition"
      >
        IN
      </a>

      <a
        href="#"
        class="text-white w-10 h-10 rounded-full bg-gray-800 hover:bg-indigo-600 flex items-center justify-center transition"
      >
        IG
      </a>

      <a
        href="#"
        class="text-white w-10 h-10 rounded-full bg-gray-800 hover:bg-indigo-600 flex items-center justify-center transition"
      >
        X
      </a>
    </div>
  </div>
</div>

<!-- Bottom -->
<div class="border-t border-gray-100 mt-10 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
  <p class="text-base text-white">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} .</p>

  <div class="flex gap-6 text-white text-sm">
    <a href="#" class="">
       {% for link in linklists[section.settings.menu_1].links %}
        <li class="list-none"><a href="{{ link.url }}" class="hover:text-gray-300 text-white transition text-base">{{ link.title }}</a></li>
      {% endfor %}
    </a>

    <a href="#" class="">
       {% for link in linklists[section.settings.menu_2].links %}
        <li class="list-none"><a href="{{ link.url }}" class="hover:text-gray-300 text-white transition text-base">{{ link.title }}</a></li>
      {% endfor %}
    </a>
  </div>
</div>




{% schema %}
{
  "name": "Footer",
  "settings": [
   
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer Menu"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "privacy"
    },
     {
      "type": "link_list",
      "id": "menu_2",
      "label": "terms"
    },
    
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}